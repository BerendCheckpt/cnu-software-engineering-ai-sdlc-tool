# Copy to .env and fill in. .env is ignored by git; never commit a token.
# aisdlc reads it from its home folder (AISDLC_HOME, or this repository). A value here wins over the same
# environment variable; an empty value is ignored. AISDLC_HOME itself must be an environment variable.

# SonarQube: both are needed, or the SonarQube gates are skipped. Use a user token (squ_) if the security
# hotspots should be checked too; an analysis token (sqa_) may not read them.
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

# The chat gateway in front of cnu-claude-agent (npm run gateway).
AISDLC_UPSTREAM_URL=http://localhost:8090
AISDLC_GATEWAY_HOST=127.0.0.1
AISDLC_GATEWAY_PORT=8091
